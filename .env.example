# Merit configuration. Placeholders only: copy what the web app needs to apps/web/.env.local
# (or set it on Vercel), and what the scripts need to ~/merit/.env. Never commit real values.

# ── Web app (apps/web) ──────────────────────────────────────────────────────
# Latch access tokens (lat_...). The server never holds the Anthropic or X key itself.
MERIT_JUDGE_LAT=lat_your_merit_judge_token
MERIT_X_LAT=lat_your_merit_x_token
# Optional: a campaign's own extended latch, e.g. MERIT_JUDGE_LAT__<campaign address>=lat_...
# Key the merit-check latch injects when merit-x's custom_code asks /api/latch/tweet-check.
MERIT_CHECK_KEY=replace_with_48_random_characters
# DevNet agent key: a 64-byte JSON array or base58. DevNet only.
MERIT_AGENT_SECRET_KEY=replace_with_devnet_agent_key
# 32+ random characters, e.g. `openssl rand -base64 48`
MERIT_SESSION_SECRET=replace_with_32_or_more_random_characters
# X OAuth 2.0 app: callback ${MERIT_PUBLIC_URL}/api/auth/x/callback, scopes users.read tweet.read
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
MERIT_PUBLIC_URL=http://localhost:3000
# Neon Postgres (pooled; the unpooled URL is only for migrations)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
# Vercel Cron calls /api/cron/agent with this bearer
CRON_SECRET=replace_with_random_string

# ── Latch setup (docs/LATCH_SETUP.md): credentials bound as Latch secrets, not used by the app ──
ANTHROPIC_API_KEY=sk-ant-your_key
X_BEARER_TOKEN=your_x_app_bearer_token
